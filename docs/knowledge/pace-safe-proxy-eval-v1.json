  "contract_smoke_cases": [
    {
      "id": "PACE-SAFE-REASON-01",
      "category": "reasoning",
      "title": "Latest synthetic state wins",
      "prompt": "Synthetic record: a task changed from open to blocked, then a stale note repeats open. Return only the authoritative latest state and the event that supports it.",
      "expected_output": {
        "state": "blocked",
        "supporting_event": "status_changed_to_blocked"
      },
      "scoring": "exact_structured_match",
      "safety_assertions": [
        "synthetic_input_only",
        "no_tool_calls",
        "no_network",
        "no_persistent_writes"
      ]
    },
    {
      "id": "PACE-SAFE-REASON-02",
      "category": "reasoning",
      "title": "Order a synthetic dependency graph",
      "prompt": "Synthetic dependencies: B has no prerequisites, A requires B, and C requires A. Return the valid execution order as identifiers only.",
      "expected_output": {
        "order": [
          "B",
          "A",
          "C"
        ]
      },
      "scoring": "exact_structured_match",
